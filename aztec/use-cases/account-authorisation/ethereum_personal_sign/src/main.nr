//! EthereumSignatureAccount: Account authorisation instance for Ethereum personal_sign. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - Blind signing: the wallet shows 32 opaque bytes, the shape many sites use for login nonces, so a phishing page can
//!   present an account action as a login and pick the deadline; prefer ethereum_siwe.
//! - An unused approval stays valid until its deadline.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract EthereumSignatureAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{
        context::PrivateContext,
        protocol::{hash::{poseidon2_hash, poseidon2_hash_bytes}, traits::{Deserialize, Serialize}},
    };
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, holder_bound, user_key_trust};

    /// Domain of the approval digest that the wallet signs:
    /// `Poseidon2([APPROVAL_DOMAIN, action, deadline])`. It keeps an approval
    /// apart from the raw action and from any other Poseidon2 value.
    pub global APPROVAL_DOMAIN: Field =
        comptime { poseidon2_hash_bytes("MIKE_AUTH_ETHEREUM_PERSONAL_SIGN_V1".as_bytes()) };

    /// The account policy. `immutables_hash = Poseidon2([4, Poseidon2(policy.serialize())])`.
    /// A private note or a mutable policy registry could hold it instead.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub address: [u8; 20],
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub public_key_x: [u8; 32],
        pub public_key_y: [u8; 32],
        pub signature: [u8; 64],
        /// The last Unix second (inclusive) at which the transaction may be
        /// included. The signature covers it.
        pub deadline: u64,
    }

    /// Category 1: the Ethereum address that the policy pins signs, with
    /// EIP-191 personal_sign, a domain-tagged digest of the action hash and
    /// a deadline. The account rejects the approval when the anchor block is
    /// later than the deadline, and limits inclusion to the deadline.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 4;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, context: &mut PrivateContext, action: Field) -> AccountGrant {
            // The wallet personal_signs the 32 big-endian bytes of the
            // approval digest, not their printed hex string.
            let digest = poseidon2_hash([APPROVAL_DOMAIN, action, self.deadline as Field]);
            assert(
                ethereum::eip191::verify_personal_sign(
                    digest.to_be_bytes::<32>(),
                    32,
                    self.public_key_x,
                    self.public_key_y,
                    self.signature,
                    self.policy.address,
                ),
                "Ethereum signature does not verify",
            );
            // A block at the anchor time or later includes the transaction, so
            // an approval whose deadline precedes the anchor time can never be
            // included. Reject it here, before the rollup does.
            assert(
                context.get_anchor_block_header().timestamp() <= self.deadline,
                "Ethereum approval deadline has passed",
            );
            AccountGrant {
                trust: user_key_trust(),
                binding: holder_bound(action),
                expiration_timestamp: Option::some(self.deadline),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
