//! EthereumSecretKeyAccount: Account authorisation instance for Ethereum secret key. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - No signature: the secret key is a private input of the transaction proof, so a hardware wallet cannot use this
//!   account and anything that sees the prover inputs sees the key.
//! - The key authorises any payload at every account that pins its address.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract EthereumSecretKeyAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{context::PrivateContext, protocol::{hash::poseidon2_hash, traits::{Deserialize, Serialize}}};
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, holder_bound, user_key_trust};

    /// The account policy. `immutables_hash = Poseidon2([6, Poseidon2(policy.serialize())])`.
    /// A private note or a mutable policy registry could hold it instead.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub address: [u8; 20],
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub secret_key: [u8; 32],
    }

    /// Category 1: knowledge of the secret key of the Ethereum address that
    /// the policy pins. There is no transferable signature: the key enters
    /// the local prover, and the proof of this transaction binds the action,
    /// so the holder bound it. This cannot use a hardware wallet that refuses
    /// to export the key.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 6;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, _context: &mut PrivateContext, action: Field) -> AccountGrant {
            ethereum::secret_key::assert_secret_key_for_address(self.secret_key, self.policy.address);
            AccountGrant {
                trust: user_key_trust(),
                binding: holder_bound(action),
                expiration_timestamp: Option::none(),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
