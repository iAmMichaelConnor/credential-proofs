//! EthereumSiweAccount: Account authorisation instance for Sign-In with Ethereum. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - The wallet shows the domain, URI and expiry, but the action only as a hex nonce.
//! - No statement, request id, not-before or resources field; domain and URI are checked as visible ASCII, not parsed
//!   as RFC 3986.
//! - `Issued At` after the anchor block is rejected: signers set it at or before the anchor block time.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract EthereumSiweAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{context::PrivateContext, protocol::{hash::poseidon2_hash, traits::{Deserialize, Serialize}}};
    use ethereum::siwe::{build_siwe_message, SiweContext};
    use std::meta::derive;
    use time::utc_to_unix;
    use uc_account::{AccountAuthorisation, AccountGrant, action_hex, holder_bound, user_key_trust};

    /// The account policy. `immutables_hash = Poseidon2([5, Poseidon2(policy.serialize())])`.
    /// A private note or a mutable policy registry could hold it instead.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub address: [u8; 20],
        pub domain: [u8; 128],
        pub domain_len: u32,
        pub uri: [u8; 128],
        pub uri_len: u32,
        pub chain_id: u64,
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub public_key_x: [u8; 32],
        pub public_key_y: [u8; 32],
        pub signature: [u8; 64],
        pub issued_at: [u8; 20],
        pub expiration_time: [u8; 20],
        pub current_time: [u8; 20],
    }

    /// Category 1: the Ethereum address that the policy pins signs an
    /// EIP-4361 message for the pinned domain, URI and chain whose nonce is
    /// the hex of the action hash. `current_time` must equal the anchor
    /// block time, and the expiration time must be later.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 5;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, context: &mut PrivateContext, action: Field) -> AccountGrant {
            assert_eq(
                utc_to_unix(self.current_time),
                context.get_anchor_block_header().timestamp(),
                "SIWE current time is not the anchor time",
            );
            let deadline = utc_to_unix(self.expiration_time);
            assert(deadline > context.get_anchor_block_header().timestamp(), "SIWE message expired");
            // Inclusion strictly before the signed expiration time. The
            // adapter sets it here, before the signature check: returning it
            // in the grant moves the check after the signature and changes
            // the bytecode.
            context.set_expiration_timestamp(deadline - 1);
            let message = build_siwe_message::<640, 128, 128, 64>(
                self.policy.address,
                SiweContext {
                    domain: self.policy.domain,
                    domain_len: self.policy.domain_len,
                    uri: self.policy.uri,
                    uri_len: self.policy.uri_len,
                    chain_id: self.policy.chain_id,
                    nonce: action_hex(action),
                    nonce_len: 64,
                    issued_at: self.issued_at,
                    expiration_time: self.expiration_time,
                    current_time: self.current_time,
                },
            );
            assert(
                ethereum::eip191::verify_personal_sign(
                    message.bytes,
                    message.len,
                    self.public_key_x,
                    self.public_key_y,
                    self.signature,
                    self.policy.address,
                ),
                "SIWE signature does not verify",
            );
            AccountGrant {
                trust: user_key_trust(),
                binding: holder_bound(action),
                expiration_timestamp: Option::none(),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
