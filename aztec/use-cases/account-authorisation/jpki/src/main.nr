//! JpkiAccount: Account authorisation instance for JPKI card. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - `anchor_class` 1 accepts any root the policy pins; only class 0 restricts it to the official JPKI roots.
//! - The card signs an opaque challenge. The session nullifier is siloed by account, so one card session can serve
//!   another account of the same card if the card signs for it.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract JpkiAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{
        context::PrivateContext,
        protocol::{hash::{poseidon2_hash, poseidon2_hash_bytes}, traits::{Deserialize, Serialize, ToField}},
    };
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, bytes_hash, certified_key_trust, holder_bound};

    /// The account policy. `immutables_hash = Poseidon2([16, Poseidon2(policy.serialize())])`.
    /// A private note or an authenticated mutable registry could hold it instead.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub anchor_class: u8,
        pub root_sha256: [u8; 32],
        pub holder_spki_sha256: [u8; 32],
        pub max_ocsp_age: u64,
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub root: [u8; 2048],
        pub root_len: u32,
        pub certificate: [u8; 2048],
        pub certificate_len: u32,
        pub responder: [u8; 2048],
        pub responder_len: u32,
        pub ocsp: [u8; 4096],
        pub ocsp_len: u32,
        pub holder_signature: [u8; 256],
        pub root_redc: [u128; 18],
        pub holder_redc: [u128; 18],
        pub responder_redc: [u128; 18],
        pub session: [u8; 32],
    }

    /// Category 2: the JPKI authentication key of the card that the policy
    /// pins (`holder_spki_sha256`, certified under the pinned root and not
    /// revoked by a fresh OCSP response) signs a challenge over this account,
    /// the action hash and a card session.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 16;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, context: &mut PrivateContext, action: Field) -> AccountGrant {
            let expires = jpki_auth::authorise(
                jpki_auth::AuthInput {
                    root: BoundedVec::from_parts(self.root, self.root_len),
                    certificate: BoundedVec::from_parts(self.certificate, self.certificate_len),
                    responder: BoundedVec::from_parts(self.responder, self.responder_len),
                    ocsp: BoundedVec::from_parts(self.ocsp, self.ocsp_len),
                    holder_signature: self.holder_signature,
                    root_redc: self.root_redc,
                    holder_redc: self.holder_redc,
                    responder_redc: self.responder_redc,
                },
                jpki_auth::AuthPolicy {
                    anchor_class: self.policy.anchor_class,
                    root_sha256: self.policy.root_sha256,
                    holder_spki_sha256: self.policy.holder_spki_sha256,
                    max_ocsp_age: self.policy.max_ocsp_age,
                },
                context.this_address().to_field().to_be_bytes::<32>(),
                action.to_be_bytes::<32>(),
                self.session,
                context.get_anchor_block_header().timestamp(),
            );
            // One use per session (unchanged domain tag), then inclusion
            // strictly before the end of the OCSP and certificate validity
            // that the library returns. The adapter applies both itself, in
            // this order: another order changes the bytecode.
            context.push_nullifier_unsafe(poseidon2_hash([
                comptime { poseidon2_hash_bytes("MIKE_JPKI_CARD_SESSION_V1".as_bytes()) },
                bytes_hash(self.session),
            ]));
            context.set_expiration_timestamp(expires - 1);
            AccountGrant {
                trust: certified_key_trust(bytes_hash(self.policy.root_sha256)),
                binding: holder_bound(action),
                expiration_timestamp: Option::none(),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
