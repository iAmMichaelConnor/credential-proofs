//! LineAccount: Account authorisation instance for LINE. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract LineAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};
    use uc_family_oidc::OidcAccount;

    // BEGIN HAND-WRITTEN items
    use aztec::protocol::{hash::{poseidon2_hash, poseidon2_hash_bytes}, traits::{Deserialize, Serialize}};
    use line::verify_line;
    use oidc::{JwtInput, TrustedP256Key};
    use std::meta::derive;
    use uc_family_oidc::{bounded_bytes_hash, issuer_pin, OidcLogin, OidcProviderInput, p256_key_hash, subject_id};

    /// The scheme id. `verify` pins the trait's `SCHEME` to it.
    global SCHEME: Field = 22;

    /// This provider example fixes each token segment capacity for a bounded,
    /// predictable circuit. Real deployments may raise these limits.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub public_key_x: [u8; 32],
        pub public_key_y: [u8; 32],
        pub audience: BoundedVec<u8, 32>,
        pub subject: BoundedVec<u8, 256>,
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub header_b64: [u8; 192],
        pub header_b64_len: u32,
        pub payload_b64: [u8; 1024],
        pub payload_b64_len: u32,
        pub signature_b64: [u8; 86],
        pub signature_b64_len: u32,
    }

    /// Category 3 through the OIDC family: the LINE ES256 key that the policy
    /// pins signs an ID token for the pinned channel id and subject whose
    /// nonce is the action hash's hex. `uc_family_oidc::OidcAccount` wraps
    /// this input in the generated entrypoint.
    impl OidcProviderInput for AuthInput {
        let SCHEME: u32 = 22;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn verify(self, nonce: BoundedVec<u8, 64>, now: u64) -> OidcLogin {
            assert_eq(SCHEME, Self::SCHEME as Field);
            let claims = verify_line(
                JwtInput::<192, 1024, 86> {
                    header_b64: BoundedVec::from_parts(self.header_b64, self.header_b64_len),
                    payload_b64: BoundedVec::from_parts(self.payload_b64, self.payload_b64_len),
                    signature_b64: BoundedVec::from_parts(self.signature_b64, self.signature_b64_len),
                },
                self.policy.audience,
                self.policy.subject,
                nonce,
                now,
                TrustedP256Key { public_key_x: self.policy.public_key_x, public_key_y: self.policy.public_key_y },
            );
            let issuer = comptime { poseidon2_hash_bytes("https://access.line.me".as_bytes()) };
            OidcLogin {
                issuer: issuer_pin(
                    p256_key_hash(self.policy.public_key_x, self.policy.public_key_y),
                    issuer,
                    bounded_bytes_hash(self.policy.audience),
                ),
                subject: subject_id(issuer, bounded_bytes_hash(self.policy.subject)),
                expiry: claims.expiry,
                // Not reported: the account wrapper does not read it, and the
                // provider check does not return `iat`. 0 fails any freshness
                // rule that another wrapper would apply.
                issued_at: 0,
                attribute_kind: 0,
                attribute: 0,
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, OidcAccount { input: auth });
    }
}
