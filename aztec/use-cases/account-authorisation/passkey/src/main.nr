//! PasskeyAccount: Account authorisation instance for Passkey. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - Blind signing: the authenticator shows the RP ID, not the action; a page on the pinned origin can request an
//!   assertion over any action.
//! - The assertion has no expiry: an unused one stays valid until its transaction nonce is consumed.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract PasskeyAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{context::PrivateContext, protocol::{hash::poseidon2_hash, traits::{Deserialize, Serialize}}};
    use passkey::webauthn::{assert_valid_webauthn, PasskeyPublicKey, WebAuthnAssertion, WebAuthnPolicy};
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, holder_bound, user_key_trust};

    /// The account policy. `immutables_hash = Poseidon2([1, Poseidon2(policy.serialize())])`.
    /// A private note or a mutable policy registry could hold it instead.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub key_x: [u8; 32],
        pub key_y: [u8; 32],
        pub rp_id: [u8; 64],
        pub rp_id_len: u32,
        pub origin: [u8; 128],
        pub origin_len: u32,
        pub require_user_verification: bool,
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub authenticator_data: [u8; 37],
        pub client_data_json: [u8; 256],
        pub client_data_json_len: u32,
        pub signature: [u8; 64],
    }

    /// Category 1: the passkey that the policy pins signs a WebAuthn
    /// assertion whose challenge is the action hash.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 1;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, _context: &mut PrivateContext, action: Field) -> AccountGrant {
            assert_valid_webauthn(
                PasskeyPublicKey { x: self.policy.key_x, y: self.policy.key_y },
                action,
                WebAuthnPolicy {
                    rp_id: self.policy.rp_id,
                    rp_id_len: self.policy.rp_id_len,
                    origin: self.policy.origin,
                    origin_len: self.policy.origin_len,
                    require_user_verification: self.policy.require_user_verification,
                },
                WebAuthnAssertion {
                    authenticator_data: self.authenticator_data,
                    client_data_json: self.client_data_json,
                    client_data_json_len: self.client_data_json_len,
                    signature: self.signature,
                },
            );
            // The verified challenge is `action`, so the holder bound it.
            AccountGrant {
                trust: user_key_trust(),
                binding: holder_bound(action),
                expiration_timestamp: Option::none(),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
