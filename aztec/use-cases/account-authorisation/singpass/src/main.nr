//! SingpassAccount: Account authorisation instance for Singpass. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - Production requires assurance level 2 or more. Singpass encrypts the ID token (JWE); the host decrypts it and the
//!   circuit verifies the inner signed token.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract SingpassAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{
        context::PrivateContext,
        protocol::{hash::{poseidon2_hash, poseidon2_hash_bytes}, traits::{Deserialize, Serialize}},
    };
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, action_hex, client_bound, identity_provider_trust};
    use uc_family_oidc::{bounded_bytes_hash, issuer_pin, p256_key_hash};

    /// The scheme id. `verify` pins the trait's `SCHEME` to it.
    global SCHEME: Field = 30;

    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub public_key_x: [u8; 32],
        pub public_key_y: [u8; 32],
        pub audience: BoundedVec<u8, 128>,
        pub subject: BoundedVec<u8, 256>,
        pub environment: u8,
        pub minimum_assurance: u8,
    }
    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub header_b64: [u8; 256],
        pub header_b64_len: u32,
        pub payload_b64: [u8; 1024],
        pub payload_b64_len: u32,
        pub signature_b64: [u8; 86],
        pub signature_b64_len: u32,
    }
    /// Category 3: the Singpass ES256 key that the policy pins signs an ID
    /// token for the pinned client id and subject, at or above the pinned
    /// assurance, whose nonce is the action hash's hex. A direct impl, not
    /// `OidcAccount`: the family wrapper computes the nonce before the token
    /// segments, and that order changes this account's ACIR.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 30;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, context: &mut PrivateContext, action: Field) -> AccountGrant {
            assert_eq(SCHEME, Self::SCHEME as Field);
            let now = context.get_anchor_block_header().timestamp();
            let claims = singpass::authorise(
                oidc::JwtInput::<256, 1024, 86> {
                    header_b64: BoundedVec::from_parts(self.header_b64, self.header_b64_len),
                    payload_b64: BoundedVec::from_parts(self.payload_b64, self.payload_b64_len),
                    signature_b64: BoundedVec::from_parts(self.signature_b64, self.signature_b64_len),
                },
                oidc::TrustedP256Key { public_key_x: self.policy.public_key_x, public_key_y: self.policy.public_key_y },
                singpass::AuthPolicy {
                    audience: self.policy.audience,
                    subject: self.policy.subject,
                    environment: self.policy.environment,
                    minimum_assurance: self.policy.minimum_assurance,
                },
                BoundedVec::from_array(action_hex(action)),
                now,
            );
            let issuer = if self.policy.environment == 0 {
                comptime {
                    poseidon2_hash_bytes("https://id.singpass.gov.sg/fapi".as_bytes())
                }
            } else {
                comptime {
                    poseidon2_hash_bytes("https://stg-id.singpass.gov.sg/fapi".as_bytes())
                }
            };
            AccountGrant {
                trust: identity_provider_trust(
                    issuer_pin(
                        p256_key_hash(self.policy.public_key_x, self.policy.public_key_y),
                        issuer,
                        bounded_bytes_hash(self.policy.audience),
                    ),
                    3,
                ),
                binding: client_bound(action),
                expiration_timestamp: Option::some(claims.expiry - 1),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
