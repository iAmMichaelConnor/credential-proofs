//! TwitterReclaimAccount: Account authorisation instance for Reclaim (X profile). Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - The attestor is a co-authority and the prover writes the context. The official X provider profile rejects every
//!   nonempty proof, so this account cannot be used with it; a field named `username` does not establish its
//!   provenance.
//! - The session nullifier is siloed by account.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract TwitterReclaimAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{
        context::PrivateContext,
        protocol::{hash::{poseidon2_hash, poseidon2_hash_bytes}, traits::{Deserialize, Serialize, ToField}},
    };
    use reclaim_auth::{ReclaimClaim, ReclaimPolicy, verify_claim};
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, action_hex, attestor_trust, bytes_hash, prover_bound};

    /// Immutable account policy, `immutables_hash = Poseidon2([9, Poseidon2(policy.serialize())])`. `parameters_hash`
    /// and `provider_hash` come
    /// from the approved Reclaim Twitter/X provider version, not proof input.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub parameters_hash: [u8; 32],
        pub provider_hash: [u8; 32],
        pub username: [u8; 15],
        pub username_len: u32,
        pub attestor_x: [u8; 32],
        pub attestor_y: [u8; 32],
        pub attestor_address: [u8; 20],
        pub epoch: u32,
        pub max_age_seconds: u32,
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub provider: [u8; 8],
        pub provider_len: u32,
        pub parameters: [u8; 1024],
        pub parameters_len: u32,
        pub context: [u8; 1024],
        pub context_len: u32,
        pub reclaim_session_id: [u8; 128],
        pub reclaim_session_id_len: u32,
        pub owner: [u8; 42],
        pub timestamp_s: u32,
        pub epoch: u32,
        pub identifier: [u8; 32],
        pub signature: [u8; 65],
    }

    /// Category 4: the Reclaim attestor that the policy pins signs a claim
    /// whose context names this account, the action hash, the enrolled X
    /// username and the session. Whoever requests the proof chooses the
    /// context (`SET_BY_PROVER`); the attestor is part of the authority.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 9;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        /// The enrolled username and the session id must be short, plain
        /// identifiers (checked before the action hash).
        fn check_input(self) {
            assert((self.policy.username_len > 0) & (self.policy.username_len <= 15));
            for i in 0..15 {
                if i < self.policy.username_len {
                    assert(
                        (self.policy.username[i] >= 48) & (self.policy.username[i] <= 57)
                            | (self.policy.username[i] >= 65) & (self.policy.username[i] <= 90)
                            | (self.policy.username[i] >= 97) & (self.policy.username[i] <= 122)
                            | (self.policy.username[i] == 95),
                    );
                }
            }
            assert((self.reclaim_session_id_len > 0) & (self.reclaim_session_id_len <= 128));
            for i in 0..128 {
                if i < self.reclaim_session_id_len {
                    let b = self.reclaim_session_id[i];
                    assert(
                        (b >= 48) & (b <= 57) | (b >= 65) & (b <= 90) | (b >= 97) & (b <= 122) | (b == 45) | (b == 95),
                    );
                }
            }
        }

        fn authorise(self, context: &mut PrivateContext, action: Field) -> AccountGrant {
            let account_bytes = context.this_address().to_field().to_be_bytes::<32>();
            let action_hex = action_hex(action);
            let (expected_context, expected_context_len) = make_expected_context(
                account_bytes,
                action_hex,
                self.policy.username,
                self.policy.username_len,
                self.policy.provider_hash,
                self.reclaim_session_id,
                self.reclaim_session_id_len,
            );
            let now = context.get_anchor_block_header().timestamp();
            let reclaim_id = verify_claim(
                ReclaimClaim::<8, 1024, 1024> {
                    provider: self.provider,
                    provider_len: self.provider_len,
                    parameters: self.parameters,
                    parameters_len: self.parameters_len,
                    context: self.context,
                    context_len: self.context_len,
                    owner: self.owner,
                    timestamp_s: self.timestamp_s,
                    epoch: self.epoch,
                    identifier: self.identifier,
                    signature: self.signature,
                },
                ReclaimPolicy::<8> {
                    provider: [104, 116, 116, 112, 0, 0, 0, 0],
                    provider_len: 4,
                    parameters_hash: self.policy.parameters_hash,
                    attestor_x: self.policy.attestor_x,
                    attestor_y: self.policy.attestor_y,
                    attestor_address: self.policy.attestor_address,
                    expected_epoch: self.policy.epoch,
                    max_age_seconds: self.policy.max_age_seconds,
                },
                expected_context,
                expected_context_len,
                now,
            );
            // Reclaim's docs make caller-side session dedup the replay
            // defense: nullify the signed session context once per account
            // (its own domain tag). The adapter pushes it and requests the
            // expiry itself; another order changes the bytecode.
            let mut session: [u8; 128] = [0; 128];
            for i in 0..128 {
                if i < self.reclaim_session_id_len {
                    session[i] = self.reclaim_session_id[i];
                }
            }
            context.push_nullifier_unsafe(poseidon2_hash([
                comptime { poseidon2_hash_bytes("MIKE_RECLAIM_SESSION_NULLIFIER_V1".as_bytes()) },
                bytes_hash(session),
                self.reclaim_session_id_len as Field,
            ]));
            // Ensure the checked credential has a well-formed identifier as
            // well; the session nullifier above is the replay key.
            assert(!all_zero(reclaim_id));
            context.set_expiration_timestamp(self.timestamp_s as u64 + self.policy.max_age_seconds as u64);
            AccountGrant {
                trust: attestor_trust(bytes_hash(self.policy.attestor_address)),
                binding: prover_bound(action),
                expiration_timestamp: Option::none(),
                session_nullifier: Option::none(),
            }
        }
    }

    #[contract_library_method]
    fn make_expected_context(
        account: [u8; 32],
        action: [u8; 64],
        username: [u8; 15],
        username_len: u32,
        provider_hash: [u8; 32],
        session: [u8; 128],
        session_len: u32,
    ) -> ([u8; 1024], u32) {
        let out: [u8; 1024] = [0; 1024];
        let (out1, cursor1) = append(out, 0, "{\"contextAddress\":\"0x".as_bytes(), 21);
        let (out2, cursor2) = append_hex(out1, cursor1, account, 32);
        let (out3, cursor3) = append(out2, cursor2, "\",\"contextMessage\":\"".as_bytes(), 20);
        let (out4, cursor4) = append(out3, cursor3, action, 64);
        let (out5, cursor5) = append(
            out4,
            cursor4,
            "\",\"extractedParameters\":{\"username\":\"".as_bytes(),
            37,
        );
        let (out6, cursor6) = append(out5, cursor5, username, username_len);
        let (out7, cursor7) = append(out6, cursor6, "\"},\"providerHash\":\"0x".as_bytes(), 21);
        let (out8, cursor8) = append_hex(out7, cursor7, provider_hash, 32);
        let (out9, cursor9) = append(out8, cursor8, "\",\"reclaimSessionId\":\"".as_bytes(), 22);
        let (out10, cursor10) = append(out9, cursor9, session, session_len);
        let (out11, cursor11) = append(out10, cursor10, "\"}".as_bytes(), 2);
        assert(cursor11 <= 1024);
        (out11, cursor11)
    }

    #[contract_library_method]
    fn append<let N: u32, let K: u32>(mut out: [u8; N], cursor: u32, value: [u8; K], len: u32) -> ([u8; N], u32) {
        assert(len <= K);
        assert(cursor + len <= N);
        for i in 0..K {
            if i < len {
                out[cursor + i] = value[i];
            }
        }
        (out, cursor + len)
    }

    #[contract_library_method]
    fn append_hex<let N: u32, let K: u32>(mut out: [u8; N], cursor: u32, value: [u8; K], len: u32) -> ([u8; N], u32) {
        let alphabet = "0123456789abcdef".as_bytes();
        assert(cursor + len * 2 <= N);
        for i in 0..K {
            if i < len {
                out[cursor + 2 * i] = alphabet[(value[i] >> 4) as u32];
                out[cursor + 2 * i + 1] = alphabet[(value[i] & 15) as u32];
            }
        }
        (out, cursor + len * 2)
    }

    #[contract_library_method]
    fn all_zero(value: [u8; 32]) -> bool {
        let mut zero = true;
        for i in 0..32 {
            zero = zero & (value[i] == 0);
        }
        zero
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
