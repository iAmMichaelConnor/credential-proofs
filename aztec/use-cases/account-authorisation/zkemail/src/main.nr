//! DkimAccount: Account authorisation instance for zkEmail action email. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - The service that operates the pinned sender mailbox must send the action mail only at the mailbox owner's request;
//!   ownership is not inferred from `To`.
//! - The mail has no expiry: only the transaction nonce stops a replay.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;
pub mod profile;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract DkimAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{context::PrivateContext, protocol::{hash::poseidon2_hash, traits::{Deserialize, Serialize}}};
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, action_hex, identity_provider_trust, sender_bound};
    use uc_adapter_zkemail::dkim_issuer;
    use zkemail::{dkim::RSAPubkey, KEY_LIMBS_2048};

    /// A narrowly scoped trusted-email identity. The configured From mailbox
    /// is owned and emitted only by the service identified by service_domain.
    /// The immutable DKIM key must be the key that service publishes for this
    /// domain and selector. This contract does not infer ownership from To.
    /// `immutables_hash = Poseidon2([8, Poseidon2(policy.serialize())])`.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub modulus: [Field; 18],
        pub redc: [Field; 18],
        pub sender: [u8; 96],
        pub sender_len: u32,
        pub service_domain: [u8; 64],
        pub service_domain_len: u32,
        pub selector: [u8; 64],
        pub selector_len: u32,
    }

    /// The signature is a standard 2048-bit RSA DKIM `b=` value decoded into
    /// the verifier's 18 little-endian 120-bit limbs. All signed content is
    /// reconstructed from policy and this entrypoint's action.
    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub signature: [Field; 18],
    }

    /// Category 3: the DKIM key that the policy pins (the mail domain)
    /// signs a message from the pinned sender mailbox whose body is
    /// `CRED-PROOF-ACTION:<action hex>`. The mailbox sender wrote the body;
    /// the domain and the mailbox operator can also produce one.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 8;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, _context: &mut PrivateContext, action: Field) -> AccountGrant {
            validate_policy(self.policy);
            let signed_header: BoundedVec<u8, 512> = crate::profile::signed_header(
                self.policy.sender,
                self.policy.sender_len,
                self.policy.service_domain,
                self.policy.service_domain_len,
                self.policy.selector,
                self.policy.selector_len,
                action_hex(action),
            );
            let key = RSAPubkey::<KEY_LIMBS_2048>::new(self.policy.modulus, self.policy.redc);
            let _verified_header_hash = key.verify_dkim_signature(signed_header, self.signature);
            AccountGrant {
                // also_authorised 5 = ALSO_IDP | ALSO_MAIL_OPERATOR.
                // The issuer is the pinned DKIM key, domain and selector, as
                // in the zkEmail event-proof adapter.
                trust: identity_provider_trust(
                    dkim_issuer(
                        self.policy.modulus,
                        self.policy.redc,
                        BoundedVec::from_parts(self.policy.service_domain, self.policy.service_domain_len),
                        BoundedVec::from_parts(self.policy.selector, self.policy.selector_len),
                    ),
                    5,
                ),
                binding: sender_bound(action),
                expiration_timestamp: Option::none(),
                session_nullifier: Option::none(),
            }
        }
    }

    #[contract_library_method]
    fn validate_policy(policy: AuthPolicy) {
        assert(policy.sender_len > 0 & policy.sender_len <= 96, "invalid sender length");
        assert(policy.service_domain_len > 0 & policy.service_domain_len <= 64, "invalid DKIM domain length");
        assert(policy.selector_len > 0 & policy.selector_len <= 64, "invalid DKIM selector length");

        let mut at_count = 0;
        let mut at_index = 0;
        for i in 0..96 {
            if i < policy.sender_len {
                let c = policy.sender[i];
                assert(is_sender_char(c), "unsupported sender mailbox character");
                if c == 64 {
                    at_count += 1;
                    at_index = i;
                }
            }
        }
        assert(at_count == 1, "sender must contain one at-sign");
        assert(at_index > 0, "sender local part is empty");
        assert(at_index + policy.service_domain_len + 1 == policy.sender_len, "sender domain mismatch");
        for i in 0..64 {
            if i < policy.service_domain_len {
                let c = policy.service_domain[i];
                assert(is_domain_char(c), "unsupported service domain character");
                assert(policy.sender[at_index + 1 + i] == c, "sender domain mismatch");
            }
            if i < policy.selector_len {
                assert(is_selector_char(policy.selector[i]), "unsupported DKIM selector character");
            }
        }
    }

    #[contract_library_method]
    fn is_sender_char(c: u8) -> bool {
        ((c >= 97) & (c <= 122)) | ((c >= 48) & (c <= 57)) | (c == 46) | (c == 95) | (c == 45) | (c == 43) | (c == 64)
    }

    #[contract_library_method]
    fn is_domain_char(c: u8) -> bool {
        ((c >= 97) & (c <= 122)) | ((c >= 48) & (c <= 57)) | (c == 46) | (c == 45)
    }

    #[contract_library_method]
    fn is_selector_char(c: u8) -> bool {
        ((c >= 97) & (c <= 122)) | ((c >= 48) & (c <= 57)) | (c == 45)
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
