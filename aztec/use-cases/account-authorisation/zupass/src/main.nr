//! ZupassAccount: Account authorisation instance for Zupass POD and holder key. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions. The input structs and the `AccountAuthorisation`
//! impl live in the items region, so the entrypoint ABI names this crate's types.
//!
//! Residual risk and notes (see also account-authorisation/README.md):
//! - The approval POD's action entry is an opaque hash. Software that signs, for another party, a POD with
//!   `_aztec_auth_v1_*` entries or a raw field (`signPODRoot`) with the holder key is a signing oracle for this
//!   account.
//! - The policy pins one `content_id`, so another POD the issuer signs for another key does not count.
use aztec::{macros::{aztec, AztecConfig}, messages::discovery::do_sync_state_no_op};

mod fixture;
mod test;

#[aztec(AztecConfig::new().custom_sync_state(do_sync_state_no_op))]
pub contract ZupassAccount {
    use aztec::{authwit::entrypoint::app::AppPayload, macros::functions::{allow_phase_change, external}};

    // BEGIN HAND-WRITTEN items
    use aztec::{context::PrivateContext, protocol::{hash::poseidon2_hash, traits::{Deserialize, Serialize, ToField}}};
    use std::meta::derive;
    use uc_account::{AccountAuthorisation, AccountGrant, certified_key_trust, holder_bound};
    use zupass::{HolderApproval, PublicKey, Signature};

    /// The account policy. `immutables_hash = Poseidon2([7, Poseidon2(policy.serialize())])`.
    /// A private note or a mutable policy registry could hold it instead.
    #[derive(Serialize, Deserialize)]
    pub struct AuthPolicy {
        pub issuer_x: Field,
        pub issuer_y: Field,
        pub holder_name_hash: Field,
        // This minimal profile enrolls one particular POD content root.
        pub content_id: Field,
    }

    #[derive(Serialize, Deserialize)]
    pub struct AuthInput {
        pub policy: AuthPolicy,
        pub issuer_rx: Field,
        pub issuer_ry: Field,
        pub issuer_s: Field,
        pub holder_x: Field,
        pub holder_y: Field,
        pub depth: u32,
        pub indices: [bool; 8],
        pub siblings: [Field; 8],
        /// The approval POD's `_aztec_auth_v1_expires` entry (Unix seconds,
        /// exclusive).
        pub expires: u64,
        pub holder_rx: Field,
        pub holder_ry: Field,
        pub holder_s: Field,
    }

    /// Category 2: the POD issuer that the policy pins signed the enrolled
    /// POD, whose entry `holder_name_hash` names the holder key, and that
    /// holder key signs a holder approval POD with exactly the entries
    /// `_aztec_auth_v1_account` (this account), `_aztec_auth_v1_action` (the
    /// action hash) and `_aztec_auth_v1_expires`. The circuit recomputes the
    /// approval POD's content ID: honest holder software signs this POD, not
    /// the action field. A raw signer over the root is still an oracle.
    impl AccountAuthorisation for AuthInput {
        let SCHEME: u32 = 7;

        fn policy_hash(self) -> Field {
            poseidon2_hash(self.policy.serialize())
        }

        fn authorise(self, context: &mut PrivateContext, action: Field) -> AccountGrant {
            let now = context.get_anchor_block_header().timestamp();
            assert(now < self.expires, "Holder approval expired");
            zupass::assert_holder_approval(
                self.policy.content_id,
                PublicKey { x: self.policy.issuer_x, y: self.policy.issuer_y },
                Signature { rx: self.issuer_rx, ry: self.issuer_ry, s: self.issuer_s },
                PublicKey { x: self.holder_x, y: self.holder_y },
                self.policy.holder_name_hash,
                self.depth,
                self.indices,
                self.siblings,
                HolderApproval { account: context.this_address().to_field(), action, expires: self.expires },
                Signature { rx: self.holder_rx, ry: self.holder_ry, s: self.holder_s },
            );
            AccountGrant {
                // The POD issuer key that the policy pins certifies the holder key.
                trust: certified_key_trust(poseidon2_hash([self.policy.issuer_x, self.policy.issuer_y])),
                binding: holder_bound(action),
                // Inclusion strictly before the approval's exclusive expiry.
                expiration_timestamp: Option::some(self.expires - 1),
                session_nullifier: Option::none(),
            }
        }
    }
    // END HAND-WRITTEN items

    /// Executes `payload` when `auth` authorises its action hash.
    #[external("private")]
    #[allow_phase_change]
    fn entrypoint(payload: AppPayload, auth: AuthInput) {
        uc_account::entrypoint(self.context, payload, auth);
    }
}
