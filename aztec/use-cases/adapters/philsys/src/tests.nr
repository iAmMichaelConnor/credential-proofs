// Unit tests of the adapter. The QR tests that need a TXE session are in
// attribute-gating/philsys/src/test.nr. The constrained tests run here with
// `nargo test` (no TXE, default threads): `fixture.nr` is the instance QR,
// generated by scripts/fixtures/generators/philsys.mjs.
use crate::{credential_id, fixture::{ISSUER_KEY, qr}, issuer_pin, PhilsysQr, SCHEME_PHILSYS};
use uc_attribute_gate::{
    assert_attribute_claim, AttributeClaim, AttributeEvidence, GateTerms, KIND_ISSUER_AUTHENTIC, PREDICATE_EQ,
};
use uc_trust::{ALSO_COPY_HOLDER, ANCHOR_NONE, Binding, SET_BY_NONE, SOURCE_DOCUMENT_ISSUER, Trust, TrustPolicy};

#[test]
fn credential_id_separates_key_and_digest() {
    let mut a = [0; 32];
    a[0] = 1;
    let b = [0; 32];
    assert(credential_id(a, b) != credential_id(b, a));
    assert(issuer_pin(a) != issuer_pin(b));
}

/// The terms of attribute-gating/philsys: a QR signed by the pinned issuer key
/// is authentic (value 1); undated and unbound evidence accepted.
fn terms() -> GateTerms {
    GateTerms {
        accepted: TrustPolicy {
            source: SOURCE_DOCUMENT_ISSUER,
            issuer: issuer_pin(ISSUER_KEY),
            anchor_kind: ANCHOR_NONE,
            anchor: 0,
            min_finality: 0,
            refuse_also: 0,
        },
        kind: KIND_ISSUER_AUTHENTIC,
        predicate: PREDICATE_EQ,
        threshold: 1,
        max_age: 3600,
        allow_undated: true,
        allow_unbound: true,
        scope: 0x9a7e,
    }
}

/// The claim that the instance's QR must give.
fn expected_claim() -> AttributeClaim {
    AttributeClaim {
        trust: Trust {
            source: SOURCE_DOCUMENT_ISSUER,
            issuer: issuer_pin(ISSUER_KEY),
            anchor_kind: ANCHOR_NONE,
            anchor: 0,
            finality: 0,
            also_authorised: ALSO_COPY_HOLDER,
        },
        kind: KIND_ISSUER_AUTHENTIC,
        value: 1,
        subject: credential_id(ISSUER_KEY, qr().credential_digest),
        binding: Binding { value: 0, set_by: SET_BY_NONE },
        issued_at: 0,
    }
}

// The adapter's verification under the ACVM (constrained execution), and the
// gate's context-free rules (trust, kind, predicate, binding, subject) on the
// claim it returns, with the instance's terms. The TXE tests of the instance
// run the same code unconstrained.
#[test]
fn constrained_claim_of_the_fixture() {
    let claim = qr().claim();
    assert(claim == expected_claim());
    assert_attribute_claim(terms(), claim, 0);
}

#[test]
fn scheme_ids_match() {
    assert_eq(<PhilsysQr as AttributeEvidence>::SCHEME, SCHEME_PHILSYS);
}
