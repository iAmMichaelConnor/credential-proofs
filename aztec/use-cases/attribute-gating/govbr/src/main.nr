//! HAND-WRITTEN regions.
//!
//! Residual risk and notes (see also attribute-gating/README.md):
//! - `sub` is the CPF: anyone can compute the gate nullifier of every CPF and learn which CPFs used this app, as with
//!   the gov.br login link.
//! - The level is what gov.br reports at login. Tokens live 60 s.
use aztec::macros::aztec;

mod fixture;
mod test;

#[aztec]
pub contract GovbrAttributeGate {
    use aztec::macros::functions::external;
    use uc_adapter_govbr::GovbrIdToken;
    use uc_attribute_gate::GateTerms;
    use uc_family_oidc::OidcAttribute;

    // BEGIN HAND-WRITTEN items
    use aztec::{macros::events::event, messages::delivery::MessageDelivery};

    /// The fixed effect: an admission receipt with the attribute that the
    /// terms gated on (the attribute kind and the signed assurance rank). It has no free argument.
    #[event]
    struct Admitted {
        kind: u32,
        value: Field,
    }
    // END HAND-WRITTEN items

    /// Applies the fixed effect when the attribute predicate holds, once per
    /// subject per app.
    #[external("private")]
    fn act(terms: GateTerms, evidence: GovbrIdToken) {
        let claim = uc_attribute_gate::gate(self.context, terms, OidcAttribute { input: evidence });
        // BEGIN HAND-WRITTEN effect
        // The receipt goes to the caller, which the token's nonce binds: only
        // the holder's OIDC client (or gov.br) could choose it.
        self.emit(Admitted { kind: claim.kind, value: claim.value }).deliver_to(
            self.msg_sender(),
            MessageDelivery::onchain_constrained(),
        );
        // END HAND-WRITTEN effect
    }
}
