//! PhilsysAttributeGate: Attribute gating instance for PhilSys legacy PhilID QR. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions.
//!
//! Residual risk and notes (see also attribute-gating/README.md):
//! - Undated (`allow_undated`): an old copy works as well as a new one. Proves issuer authenticity only, not the
//!   presenter, active status or revocation; one use per QR, not per person.
//! - No authentic positive issuer vector exists: pinning a synthetic key accepts anyone's QRs. Legacy JSON QR only (not
//!   COSE ePhilID). The compiler reports an unresolved Brillig-coverage diagnostic in the upstream SHA-512 path.
use aztec::macros::aztec;

mod fixture;
mod test;

#[aztec]
pub contract PhilsysAttributeGate {
    use aztec::macros::functions::external;
    use uc_adapter_philsys::PhilsysQr;
    use uc_attribute_gate::GateTerms;

    // BEGIN HAND-WRITTEN items
    // END HAND-WRITTEN items

    /// Applies the fixed effect when the attribute predicate holds, once per
    /// subject per app.
    #[external("private")]
    fn act(terms: GateTerms, evidence: PhilsysQr) {
        let claim = uc_attribute_gate::gate(self.context, terms, evidence);
        // BEGIN HAND-WRITTEN effect
        // Record only. The core's nullifier records that this credential, with
        // the gated attribute, was presented once in this app. Anyone who
        // holds a copy can present it from any account, so the effect gives
        // the caller nothing: a benefit for the caller would go to whoever
        // presents a copy first. An app that needs a recipient
        // takes it from evidence that names one.
        let _ = claim;
        // END HAND-WRITTEN effect
    }
}
