//! ZupassAttributeGate: Attribute gating instance for Zupass holder-bound ticket entry. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions.
//!
//! Residual risk and notes (see also attribute-gating/README.md):
//! - The nullifier subject is the ticket POD (`pod_id`), not the holder: one use per POD whatever the entry or choice.
//! - The pinned numeric entry must mean a nonnegative `int` (POD `int`, `cryptographic`, `boolean` and `date` hash
//!   alike). The holder's signed time says nothing about ticket expiry or revocation.
use aztec::macros::aztec;

mod fixture;
mod test;

#[aztec]
pub contract ZupassAttributeGate {
    use aztec::macros::functions::external;
    use uc_adapter_zupass::ZupassHolderEntry;
    use uc_attribute_gate::GateTerms;

    // BEGIN HAND-WRITTEN items
    use aztec::{macros::events::event, messages::delivery::MessageDelivery};
    #[event]
    struct Admitted {
        ticket_value: Field,
        choice: Field,
    }
    // END HAND-WRITTEN items

    /// Applies the fixed effect when the attribute predicate holds, once per
    /// subject per app.
    #[external("private")]
    fn act(terms: GateTerms, evidence: ZupassHolderEntry, choice: Field) {
        let claim = uc_attribute_gate::gate_with_choice(self.context, terms, evidence, choice);
        // BEGIN HAND-WRITTEN effect
        self.emit(Admitted { ticket_value: claim.value, choice }).deliver_to(
            self.msg_sender(),
            MessageDelivery::onchain_constrained(),
        );
        // END HAND-WRITTEN effect
    }
}
