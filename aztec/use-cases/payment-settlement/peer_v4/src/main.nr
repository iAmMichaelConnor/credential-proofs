//! PeerV4Settlement: Payment settlement instance for Peer V4. Generated by
//! aztec/use-cases/scripts/generate.py from use-cases.json; edit only the
//! HAND-WRITTEN regions.
//!
//! Residual risk and notes (see also payment-settlement/README.md):
//! - Reference: the Peer intent hash (`external_reference`), which does not name this contract: two orders that pin the
//!   same intent both settle one payment. Pin each intent in one order only.
//! - The same attestation also releases the intent's escrow on Base. Fiat reversal and the intent's Base state are not
//!   checked. A multisig witness set needs a threshold-aware adapter.
use aztec::macros::aztec;

mod fixture;
mod test;

#[aztec]
pub contract PeerV4Settlement {
    use aztec::macros::functions::external;
    use uc_adapter_peer_v4::PeerV4Payment;
    use uc_payment_settlement::Order;

    // BEGIN HAND-WRITTEN items
    use aztec::{macros::events::event, messages::delivery::MessageDelivery};

    /// The fixed effect: a settlement receipt that only the order's
    /// beneficiary receives. A deployment that releases tokens calls the
    /// token contract here instead, with the same recipient and amount.
    #[event]
    struct Settled {
        order_id: Field,
        payment_id: Field,
        amount: u128,
    }
    // END HAND-WRITTEN items

    /// Settles the order once when a matching payment is proven. The effect
    /// goes to the beneficiary that the order names.
    #[external("private")]
    fn settle(order: Order, evidence: PeerV4Payment) {
        let payment = uc_payment_settlement::settle(self.context, order, evidence);
        // BEGIN HAND-WRITTEN effect
        self
            .emit(Settled { order_id: order.order_id, payment_id: payment.payment_id, amount: payment.amount })
            .deliver_to(order.beneficiary, MessageDelivery::onchain_constrained());
        // END HAND-WRITTEN effect
    }
}
