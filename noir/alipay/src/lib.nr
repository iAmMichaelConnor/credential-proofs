//! Exact Alipay RSA2 response verification. The caller supplies an authenticated
//! Alipay key. A signed response is not automatically authorization of an action.
//!
//! `verify_v2_signed_body` (the raw response subobject) and `verify_v3_response`
//! (`timestamp LF nonce LF body LF`, millisecond timestamp) check RSA-2048
//! PKCS#1 v1.5 SHA-256 (RSA2 only, not legacy RSA/SHA-1) and return the digest.
//! Bind identity or payment facts on the same body with `assert_string_claim`
//! or `assert_trade_query_claims`. The flat profile accepts raw UTF-8 strings
//! (Chinese text included), unsigned integers, booleans and null, and rejects
//! escapes, nested values and duplicate selected claims; a valid response
//! outside it needs a broader parser, never normalization.
//!
//! Caller obligations:
//! - The key comes from account or application policy; a response certificate
//!   serial is only a selector, and a prover-chosen key proves nothing.
//! - The v3 nonce is Alipay's, not an Aztec challenge, and the signature covers
//!   no HTTP method, path, application ID or request body.
//! - The trade-query profile authenticates no seller or application ID: the
//!   pinned key identifies the response signer, not a merchant, and Alipay's
//!   payment guide requires seller and application checks.
//! - No signed field is chosen by the user and `out_trade_no` is the merchant's,
//!   so a response cannot authorize an arbitrary transaction (payment evidence).
//! - Binding `open_id` needs a value capacity of at least 47 bytes.
pub use rsa_http::RSAPubkey;
mod claims;
pub use claims::{assert_string_claim, assert_trade_query_claims, yuan_text};

/// API v2 signs the exact bytes of the response subobject, without its outer
/// method-name key, sign field, or surrounding envelope. No JSON reserialization.
pub fn verify_v2_signed_body<let N: u32>(
    body: BoundedVec<u8, N>,
    signature: [Field; 18],
    key: RSAPubkey<18>,
) -> [u8; 32] {
    assert((body.len() > 0) & (body.len() <= N), "invalid response length");
    key.verify_rsa_sha256_pkcs1v15(body, signature)
}

/// API v3 signs timestamp + LF + nonce + LF + complete raw body + LF.
/// The response nonce is generated by Alipay; do not assume it echoes a caller
/// challenge. The URL, method, app ID and request body are not in this preimage.
pub fn verify_v3_response<let N: u32>(
    timestamp: BoundedVec<u8, 20>,
    nonce: BoundedVec<u8, 128>,
    body: BoundedVec<u8, N>,
    signature: [Field; 18],
    key: RSAPubkey<18>,
    now_ms: u64,
    max_age_ms: u64,
) -> [u8; 32] {
    rsa_http::verify_response(timestamp, nonce, body, signature, key, now_ms, max_age_ms)
}
mod benchmarks;
mod known_answer_tests;
