//! Bounded EIP-191 personal-sign verification against a supplied public key.
use keccak256::keccak256;

global PERSONAL_SIGN_TEXT: [u8; 25] = "Ethereum Signed Message:\n".as_bytes();

/// Compute EIP-191 `personal_sign` digest for a bounded byte message.
///
/// `message_len` must be at most the compile-time maximum. The byte length is
/// encoded as canonical decimal ASCII, without leading zeroes.
pub fn personal_sign_digest<let MAX: u32>(message: [u8; MAX], message_len: u32) -> [u8; 32] {
    assert(message_len <= MAX);

    let mut reversed_digits: [u8; 10] = [0; 10];
    let mut value = message_len;
    for i in 0..10 {
        reversed_digits[i] = 0x30 + (value % 10) as u8;
        value = value / 10;
    }
    let mut digit_len = 1;
    for i in 0..10 {
        if reversed_digits[i] != 0x30 {
            digit_len = i + 1;
        }
    }

    let mut input: [u8; MAX + 36] = [0; MAX + 36];
    input[0] = 0x19;
    for i in 0..25 {
        input[1 + i] = PERSONAL_SIGN_TEXT[i];
    }
    for i in 0..10 {
        if i < digit_len {
            input[26 + i] = reversed_digits[digit_len - i - 1];
        }
    }
    for i in 0..MAX {
        if i < message_len {
            input[26 + digit_len + i] = message[i];
        }
    }
    keccak256(input, 26 + digit_len + message_len)
}

/// Derive the last 20 bytes of Keccak-256(x || y), the Ethereum address form.
/// The public key is already the uncompressed coordinate pair: the SEC1 0x04
/// prefix is not part of the Ethereum address preimage.
pub fn ethereum_address(public_key_x: [u8; 32], public_key_y: [u8; 32]) -> [u8; 20] {
    let mut coordinates: [u8; 64] = [0; 64];
    for i in 0..32 {
        coordinates[i] = public_key_x[i];
        coordinates[32 + i] = public_key_y[i];
    }
    let digest = keccak256(coordinates, 64);
    let mut address: [u8; 20] = [0; 20];
    for i in 0..20 {
        address[i] = digest[12 + i];
    }
    address
}

/// Verify a 64-byte `r || s` ECDSA signature over the EIP-191 digest and bind
/// the supplied key to `expected_address`.
///
/// The verifier does not recover a key from a 65-byte signature. The caller
/// supplies the public key, and the expected address is checked against
/// Keccak-256 of that secp256k1 public key. The Noir standard
/// verifier requires canonical scalar encodings and low-s signatures.
pub fn verify_personal_sign<let MAX: u32>(
    message: [u8; MAX],
    message_len: u32,
    public_key_x: [u8; 32],
    public_key_y: [u8; 32],
    signature: [u8; 64],
    expected_address: [u8; 20],
) -> bool {
    let derived_address = ethereum_address(public_key_x, public_key_y);
    for i in 0..20 {
        assert_eq(derived_address[i], expected_address[i], "address does not match the public key");
    }
    let digest = personal_sign_digest(message, message_len);
    std::ecdsa_secp256k1::verify_signature(public_key_x, public_key_y, signature, digest)
}

#[test]
fn eip191_decimal_length_boundaries() {
    let message: [u8; 100] = [0x61; 100];
    assert_eq(
        personal_sign_digest(message, 0),
        [
            0x5f, 0x35, 0xdc, 0xe9, 0x8b, 0xa4, 0xfb, 0xa2, 0x55, 0x30, 0xa0, 0x26, 0xed, 0x80,
            0xb2, 0xce, 0xcd, 0xaa, 0x31, 0x09, 0x1b, 0xa4, 0x95, 0x8b, 0x99, 0xb5, 0x2e, 0xa1,
            0xd0, 0x68, 0xad, 0xad,
        ],
    );
    assert_eq(
        personal_sign_digest(message, 9),
        [
            0x88, 0x99, 0x52, 0x34, 0xd4, 0xeb, 0x22, 0x6a, 0xf6, 0x85, 0xfa, 0x25, 0x80, 0xee,
            0xf0, 0x84, 0x27, 0x69, 0x24, 0xab, 0x4e, 0xf7, 0x84, 0x9b, 0x29, 0x71, 0x2b, 0x10,
            0x56, 0xef, 0x39, 0x16,
        ],
    );
    assert_eq(
        personal_sign_digest(message, 10),
        [
            0x1e, 0x4b, 0xed, 0xee, 0x6a, 0xc3, 0xc9, 0x81, 0x00, 0x61, 0xc8, 0xbc, 0x59, 0x73,
            0x6e, 0x1a, 0x48, 0x2e, 0x65, 0x6d, 0xe1, 0x3b, 0x46, 0x48, 0xa7, 0xf9, 0x65, 0xb5,
            0x8f, 0xd6, 0x84, 0x3d,
        ],
    );
    assert_eq(
        personal_sign_digest(message, 99),
        [
            0xf7, 0xdd, 0x76, 0x08, 0xb0, 0xc3, 0x49, 0xa8, 0x50, 0x25, 0xcf, 0x8c, 0xd0, 0xf2,
            0x51, 0x10, 0xef, 0x34, 0x1e, 0x55, 0x5c, 0x55, 0x01, 0xbd, 0xf3, 0x17, 0x19, 0xae,
            0xe8, 0x83, 0x1f, 0x1a,
        ],
    );
    assert_eq(
        personal_sign_digest(message, 100),
        [
            0x90, 0xb4, 0x96, 0xd4, 0x43, 0x3a, 0xe2, 0xfe, 0x10, 0xbb, 0xa2, 0xf7, 0x3c, 0xa6,
            0xa2, 0x10, 0xa5, 0x7d, 0x84, 0x99, 0xdb, 0x0a, 0xe5, 0xdf, 0xb0, 0x5f, 0x3f, 0xbe,
            0xef, 0xf2, 0xb0, 0xcf,
        ],
    );
}

#[test]
fn verifies_eip191_personal_sign_and_key_address_binding() {
    let message = "hello".as_bytes();
    let x = [
        0x79, 0xbe, 0x66, 0x7e, 0xf9, 0xdc, 0xbb, 0xac, 0x55, 0xa0, 0x62, 0x95, 0xce, 0x87, 0x0b,
        0x07, 0x02, 0x9b, 0xfc, 0xdb, 0x2d, 0xce, 0x28, 0xd9, 0x59, 0xf2, 0x81, 0x5b, 0x16, 0xf8,
        0x17, 0x98,
    ];
    let y = [
        0x48, 0x3a, 0xda, 0x77, 0x26, 0xa3, 0xc4, 0x65, 0x5d, 0xa4, 0xfb, 0xfc, 0x0e, 0x11, 0x08,
        0xa8, 0xfd, 0x17, 0xb4, 0x48, 0xa6, 0x85, 0x54, 0x19, 0x9c, 0x47, 0xd0, 0x8f, 0xfb, 0x10,
        0xd4, 0xb8,
    ];
    let signature = [
        0xe5, 0xdd, 0xc1, 0x60, 0xe4, 0xc8, 0xf9, 0x2d, 0xe5, 0x07, 0xc7, 0xdb, 0x9b, 0x98, 0x2d,
        0x4f, 0x9b, 0x71, 0x97, 0xbf, 0xa4, 0x21, 0x86, 0x4a, 0xea, 0xdc, 0x58, 0x6b, 0xc9, 0x6b,
        0x09, 0xae, 0x0b, 0xa0, 0xc5, 0xb1, 0x31, 0x65, 0x0a, 0xe4, 0x99, 0x4c, 0xff, 0x18, 0x39,
        0x34, 0x1d, 0x00, 0xf3, 0x73, 0x5e, 0xf5, 0xab, 0xc6, 0x2a, 0xc8, 0xfe, 0x2c, 0xf5, 0x0f,
        0x65, 0x20, 0x8e, 0x2a,
    ];
    let address = [
        0x7e, 0x5f, 0x45, 0x52, 0x09, 0x1a, 0x69, 0x12, 0x5d, 0x5d, 0xfc, 0xb7, 0xb8, 0xc2, 0x65,
        0x90, 0x29, 0x39, 0x5b, 0xdf,
    ];
    assert(verify_personal_sign(message, 5, x, y, signature, address));
}
