//! Bounded verifier for the Ethereum-signature Reclaim claim envelope.
//!
//! Reclaim's signer signs `identifier\nowner\ntimestampS\nepoch` with EIP-191.
//! The identifier is Keccak-256 of `provider\nparameters\ncanonicalContext`.
//! The application must pin the provider configuration, expected parameters
//! hash, action context, attestor key, and freshness policy. This relation does
//! not fetch Reclaim's dynamic provider registry or prove a TLS transcript.
//!
//! `verify_claim` checks the identifier, the EIP-191 signature under the
//! policy-pinned attestor key, the provider and exact parameters hash, the exact
//! canonical context bytes (no JSON canonicalizer in circuit), the epoch and
//! `now - max_age_seconds <= timestamp_s <= now`.
//!
//! Caller obligations:
//! - Pin the attestor key and a parameters hash from a provider configuration
//!   verified through the official SDK; a proof-selected hash anchors nothing.
//!   Rotating or threshold signer sets need a policy update or a separately
//!   verified epoch/key registry.
//! - Generate the expected context in the account entrypoint (account, one-use
//!   session ID, extracted identity value, action digest) and consume the
//!   session ID or claim identifier as a nullifier.
//! - Require a mandatory value extracted from the authenticated response; empty
//!   or optional extraction must not fall back to a caller-supplied identity.
//!   The attestor keeps a caller-supplied `extractedParameters` when its rules
//!   capture nothing, so that field alone proves nothing about the response.
//! - With an anchor-block `now`, a claim stamped after the anchor is rejected
//!   until a newer block is anchored: set `max_age_seconds` well above block lag
//!   plus proving time.
//! The attestor's provider verification and TLS/TEE mechanism stay external
//! trust assumptions; this is not a native Twitter/X credential.

use ethereum_auth::eip191::verify_personal_sign;
use keccak256::keccak256;

pub struct ReclaimClaim<let P: u32, let M: u32, let C: u32> {
    pub provider: [u8; P],
    pub provider_len: u32,
    pub parameters: [u8; M],
    pub parameters_len: u32,
    pub context: [u8; C],
    pub context_len: u32,
    pub owner: [u8; 42],
    pub timestamp_s: u32,
    pub epoch: u32,
    pub identifier: [u8; 32],
    /// Standard Reclaim wire signature: r || s || v. v is checked and removed
    /// because this relation verifies against a policy-pinned public key.
    pub signature: [u8; 65],
}

pub struct ReclaimPolicy<let P: u32> {
    pub provider: [u8; P],
    pub provider_len: u32,
    /// Hash of the exact approved provider parameters bytes. This must come
    /// from deployment policy, never from the proof being verified.
    pub parameters_hash: [u8; 32],
    pub attestor_x: [u8; 32],
    pub attestor_y: [u8; 32],
    pub attestor_address: [u8; 20],
    pub expected_epoch: u32,
    pub max_age_seconds: u32,
}

/// Verify one Reclaim claim against app-anchored values. `expected_context` is
/// the exact canonical JSON byte string generated by the app for this account,
/// action, session, and extracted attribute. The policy has a fixed maximum P;
/// all input lengths are checked before any byte is hashed.
pub fn verify_claim<let P: u32, let M: u32, let C: u32>(
    claim: ReclaimClaim<P, M, C>,
    policy: ReclaimPolicy<P>,
    expected_context: [u8; C],
    expected_context_len: u32,
    now: u64,
) -> [u8; 32] {
    assert(claim.provider_len <= P);
    assert(claim.parameters_len <= M);
    assert(claim.context_len <= C);
    assert(expected_context_len <= C);
    assert(policy.provider_len <= P);
    assert(claim.provider_len == policy.provider_len);
    assert(claim.context_len == expected_context_len);
    assert_eq(claim.epoch, policy.expected_epoch);
    assert((claim.owner[0] == 48) & (claim.owner[1] == 120));
    for i in 2..42 {
        assert(
            (claim.owner[i] >= 48) & (claim.owner[i] <= 57)
                | (claim.owner[i] >= 97) & (claim.owner[i] <= 102),
        );
    }

    for i in 0..P {
        if i < claim.provider_len {
            assert_eq(claim.provider[i], policy.provider[i]);
        }
    }
    for i in 0..C {
        if i < claim.context_len {
            assert_eq(claim.context[i], expected_context[i], "Reclaim context mismatch");
        }
    }

    let mut params_hash_input: [u8; M] = [0; M];
    for i in 0..M {
        if i < claim.parameters_len {
            params_hash_input[i] = claim.parameters[i];
        }
    }
    assert_eq(
        keccak256(params_hash_input, claim.parameters_len),
        policy.parameters_hash,
        "Reclaim parameters hash mismatch",
    );

    // Reclaim's context is canonicalized as JSON before hashing. Requiring the
    // exact app-generated canonical context above makes this byte hash equal to
    // the protocol's canonicalized-context hash and rejects alternate JSON.
    let mut identifier_input: [u8; P + M + C + 2] = [0; P + M + C + 2];
    for i in 0..P {
        if i < claim.provider_len {
            identifier_input[i] = claim.provider[i];
        }
    }
    let mut cursor = claim.provider_len;
    identifier_input[cursor] = 10;
    cursor += 1;
    for i in 0..M {
        if i < claim.parameters_len {
            identifier_input[cursor + i] = claim.parameters[i];
        }
    }
    cursor += claim.parameters_len;
    identifier_input[cursor] = 10;
    cursor += 1;
    for i in 0..C {
        if i < claim.context_len {
            identifier_input[cursor + i] = claim.context[i];
        }
    }
    cursor += claim.context_len;
    let identifier = keccak256(identifier_input, cursor);
    for i in 0..32 {
        assert_eq(identifier[i], claim.identifier[i], "Reclaim claim identifier mismatch");
    }

    assert(
        (claim.signature[64] == 0)
            | (claim.signature[64] == 1)
            | (claim.signature[64] == 27)
            | (claim.signature[64] == 28),
    );
    assert((claim.timestamp_s as u64) <= now, "Reclaim claim is after the current time");
    assert(
        (now - claim.timestamp_s as u64) <= policy.max_age_seconds as u64,
        "Reclaim claim is older than policy allows",
    );

    let (sign_data, sign_data_len) = sign_data(
        claim.identifier,
        claim.owner,
        claim.timestamp_s,
        claim.epoch,
    );
    let mut rs: [u8; 64] = [0; 64];
    for i in 0..64 {
        rs[i] = claim.signature[i];
    }
    assert(
        verify_personal_sign(
            sign_data,
            sign_data_len,
            policy.attestor_x,
            policy.attestor_y,
            rs,
            policy.attestor_address,
        ),
        "Reclaim attestor signature invalid",
    );
    identifier
}

fn sign_data(
    identifier: [u8; 32],
    owner: [u8; 42],
    timestamp_s: u32,
    epoch: u32,
) -> ([u8; 132], u32) {
    let alphabet = "0123456789abcdef".as_bytes();
    let mut out: [u8; 132] = [0; 132];
    out[0] = 48;
    out[1] = 120;
    for i in 0..32 {
        out[2 + 2 * i] = alphabet[(identifier[i] >> 4) as u32];
        out[3 + 2 * i] = alphabet[(identifier[i] & 15) as u32];
    }
    out[66] = 10;
    for i in 0..42 {
        out[67 + i] = owner[i];
    }
    out[109] = 10;
    let mut ts_digits: [u8; 10] = [0; 10];
    let mut ts_remaining = timestamp_s;
    let mut ts_len = 0;
    for i in 0..10 {
        if (ts_remaining > 0) | (i == 0) {
            ts_digits[i] = 48 + (ts_remaining % 10) as u8;
            ts_remaining = ts_remaining / 10;
            ts_len += 1;
        }
    }
    for i in 0..10 {
        if i < ts_len {
            out[110 + i] = ts_digits[ts_len - i - 1];
        }
    }
    out[110 + ts_len] = 10;

    let mut epoch_digits: [u8; 10] = [0; 10];
    let mut epoch_remaining = epoch;
    let mut epoch_len = 0;
    for i in 0..10 {
        if (epoch_remaining > 0) | (i == 0) {
            epoch_digits[i] = 48 + (epoch_remaining % 10) as u8;
            epoch_remaining = epoch_remaining / 10;
            epoch_len += 1;
        }
    }
    for i in 0..10 {
        if i < epoch_len {
            out[111 + ts_len + i] = epoch_digits[epoch_len - i - 1];
        }
    }
    (out, 111 + ts_len + epoch_len)
}

fn reclaim_fixture() -> (ReclaimClaim<8, 2, 96>, ReclaimPolicy<8>, [u8; 96]) {
    let policy = ReclaimPolicy::<8> {
        provider: [104, 116, 116, 112, 0, 0, 0, 0],
        provider_len: 4,
        parameters_hash: [
            0xb4, 0x8d, 0x38, 0xf9, 0x3e, 0xaa, 0x08, 0x40, 0x33, 0xfc, 0x59, 0x70, 0xbf, 0x96,
            0xe5, 0x59, 0xc3, 0x3c, 0x4c, 0xdc, 0x07, 0xd8, 0x89, 0xab, 0x00, 0xb4, 0xd6, 0x3f,
            0x95, 0x90, 0x73, 0x9d,
        ],
        attestor_x: [
            0x79, 0xbe, 0x66, 0x7e, 0xf9, 0xdc, 0xbb, 0xac, 0x55, 0xa0, 0x62, 0x95, 0xce, 0x87,
            0x0b, 0x07, 0x02, 0x9b, 0xfc, 0xdb, 0x2d, 0xce, 0x28, 0xd9, 0x59, 0xf2, 0x81, 0x5b,
            0x16, 0xf8, 0x17, 0x98,
        ],
        attestor_y: [
            0x48, 0x3a, 0xda, 0x77, 0x26, 0xa3, 0xc4, 0x65, 0x5d, 0xa4, 0xfb, 0xfc, 0x0e, 0x11,
            0x08, 0xa8, 0xfd, 0x17, 0xb4, 0x48, 0xa6, 0x85, 0x54, 0x19, 0x9c, 0x47, 0xd0, 0x8f,
            0xfb, 0x10, 0xd4, 0xb8,
        ],
        attestor_address: [
            0x7e, 0x5f, 0x45, 0x52, 0x09, 0x1a, 0x69, 0x12, 0x5d, 0x5d, 0xfc, 0xb7, 0xb8, 0xc2,
            0x65, 0x90, 0x29, 0x39, 0x5b, 0xdf,
        ],
        expected_epoch: 1,
        max_age_seconds: 60,
    };
    let context = "{\"contextAddress\":\"0xabc\",\"contextMessage\":\"action\",\"reclaimSessionId\":\"session-1\"}"
        .as_bytes();
    let mut context_array: [u8; 96] = [0; 96];
    for i in 0..83 {
        context_array[i] = context[i];
    }
    let claim = ReclaimClaim::<8, 2, 96> {
        provider: [104, 116, 116, 112, 0, 0, 0, 0],
        provider_len: 4,
        parameters: [123, 125],
        parameters_len: 2,
        context: context_array,
        context_len: 83,
        owner: "0x0000000000000000000000000000000000000000".as_bytes(),
        timestamp_s: 1_700_000_000,
        epoch: 1,
        identifier: [
            0x43, 0x35, 0x87, 0x18, 0x9e, 0x3a, 0x28, 0xed, 0x7a, 0x55, 0xd8, 0xc9, 0xc1, 0x45,
            0x6c, 0x26, 0x99, 0xe8, 0xe1, 0x34, 0xee, 0xb1, 0xb2, 0xe0, 0x65, 0xf8, 0x3b, 0x9d,
            0xee, 0x8c, 0xdd, 0x5c,
        ],
        signature: [
            0x92, 0x39, 0xf5, 0xf1, 0x45, 0xfa, 0xba, 0xd6, 0xee, 0xc2, 0x7c, 0x00, 0x5f, 0x84,
            0xfa, 0xc1, 0xef, 0x85, 0x5b, 0xe5, 0x92, 0x22, 0x07, 0xd4, 0x3f, 0x01, 0x9c, 0x68,
            0x1a, 0x50, 0x60, 0x87, 0x7f, 0x1a, 0x59, 0x07, 0x52, 0x06, 0x6f, 0xff, 0x67, 0x55,
            0xcc, 0xbf, 0x4c, 0x5f, 0x53, 0xb9, 0x99, 0xdc, 0x03, 0xe2, 0x7d, 0xf8, 0x0f, 0xaa,
            0x54, 0x74, 0x5c, 0x6b, 0x04, 0xd1, 0xe2, 0x93, 0x1b,
        ],
    };
    (claim, policy, context_array)
}

#[test]
fn verifies_reclaim_eip191_claim_and_action_context() {
    let (claim, policy, expected_context) = reclaim_fixture();
    let result = verify_claim(claim, policy, expected_context, 83, 1_700_000_030);
    assert_eq(result[0], 0x43);
    assert_eq(result[31], 0x5c);
}

#[test(should_fail_with = "Reclaim context mismatch")]
fn rejects_action_context_substitution() {
    let (claim, policy, mut expected_context) = reclaim_fixture();
    expected_context[44] = 120;
    let _ = verify_claim(claim, policy, expected_context, 83, 1_700_000_030);
}
