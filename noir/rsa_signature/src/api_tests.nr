//! Generated synthetic RSA API regression vectors, not production keys.
use crate::RSAPubkey;
use bignum::{params::BigNumParams, RuntimeBigNum};

#[test]
fn rsa1024_generic_digest_and_legacy_agree() {
    let key: RSAPubkey<9> = RSAPubkey::new(
        [
            624482497162953589158784184673092529,
            301843291892411751853765095073782379,
            1327572555844952760438363851753086690,
            10681728706175196129507552963199458,
            939829370509282909278003353596671901,
            194075366729834796785687086398025762,
            94838757869750313661687214469235835,
            199071412627947670288575271867320613,
            16371648835603184710,
        ],
        [
            672891718131171085279828963715755506,
            366100325447934591087450071731600641,
            42334321491707049055878177443591720,
            555639453792998079966095348515535853,
            1263274970355017209226659836006658527,
            1324212045345336030958769829613804112,
            973996366690938753310999092588867479,
            839188526107726939233998413685453405,
            1330230797253579546606,
        ],
    );
    let signature: [Field; 9] = [
        195042317850847946839128169163397037,
        1013340533666256766793673818156651210,
        746924443722377414475408786764520821,
        408336293875481295595871545564407517,
        479892439534634742688721958474391411,
        641334476253824887671505669856649781,
        683305244346201336844997752640520027,
        798184906482162572570058154565555584,
        9420297182343490552,
    ];
    let message: BoundedVec<u8, 4> = BoundedVec::from_array([116u8, 101, 115, 116]);
    let digest: [u8; 32] = [
        159, 134, 208, 129, 136, 76, 125, 101, 154, 47, 234, 160, 197, 90, 208, 21, 163, 191, 79,
        27, 43, 11, 130, 44, 209, 93, 108, 21, 176, 240, 10, 8,
    ];
    assert_eq(key.verify_rsa_sha256_pkcs1v15(message, signature), digest);
    assert_eq(key.verify_dkim_signature(message, signature), digest);
    assert_eq(key.verify_digest_sha256_pkcs1v15(digest, signature), digest);
}

#[test(should_fail_with = "PKCS#1 v1.5: message hash mismatch")]
