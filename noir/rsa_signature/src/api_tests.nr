    ];
    let message: BoundedVec<u8, 4> = BoundedVec::from_array([116u8, 101, 115, 116]);
    let changed: BoundedVec<u8, 4> = BoundedVec::from_array([116u8, 101, 115, 117]);
    let _ = key.verify_rsa_sha256_pkcs1v15(changed, signature);
}

