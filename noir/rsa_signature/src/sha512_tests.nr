#[test]
fn sha512_4096_valid() {
    let (key, sig, digest) = vector_4096();
    key.assert_valid_sha512_digest(digest, sig);
}
#[test(should_fail_with = "PKCS#1 v1.5: message hash mismatch")]
fn sha512_4096_wrong_digest() {
    let (key, sig, mut digest) = vector_4096();
    digest[0] ^= 1;
    key.assert_valid_sha512_digest(digest, sig);
}
