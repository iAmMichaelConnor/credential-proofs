fn verify_fixture(
    a: BoundedVec<u8, 128>,
    u: BoundedVec<u8, 64>,
    n: BoundedVec<u8, 64>,
    now: u64,
    key: TrustedRsaKey,
    token: JwtInput<128, 512, 344>,
) {
    let _claims = verify_telegram(token, a, u, n, now, key);
}
