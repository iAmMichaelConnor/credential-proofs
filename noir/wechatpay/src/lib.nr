//! WeChat Pay APIv3 platform-signed response verification, not WeChat Login.
//! Supply a trusted platform RSA key, selected by an authenticated certificate
//! or public-key registry. A response-selected certificate is not a trust root.
//!
//! `verify_response` checks the platform RSA-SHA256 signature over the exact
//! body (seconds timestamp); `assert_payment_claims` binds, on the same body,
//! `appid`, `mchid`, `trade_state == "SUCCESS"`, `transaction_id`, `attach`,
//! `payer.openid` and the CNY `amount.total` in fen (profile in `claims.nr`;
//! consumers accept bodies up to 1024 bytes). Only the merchant controls
//! `attach`, so a payment response is payment evidence, not payer approval of
//! an arbitrary transaction; refunds and settlement elsewhere still need
//! application-level controls. `scanner_tests.nr` is generated by
//! `scripts/fixtures/generate-wechatpay-scanner-tests.py`.
pub use rsa_http::RSAPubkey;
mod claims;
mod scanner_tests;
pub use claims::assert_payment_claims;

/// Signature preimage: Wechatpay-Timestamp LF Wechatpay-Nonce LF raw-body LF.
/// Timestamp units are Unix SECONDS, unlike Alipay v3's milliseconds.
/// This bounded credential profile requires a nonempty response body. Encrypted
/// notification resources are authenticated ciphertext, not verified plaintext.
pub fn verify_response<let N: u32>(
    timestamp: BoundedVec<u8, 20>,
    nonce: BoundedVec<u8, 128>,
    body: BoundedVec<u8, N>,
    signature: [Field; 18],
    key: RSAPubkey<18>,
    now_seconds: u64,
    max_age_seconds: u64,
) -> [u8; 32] {
    rsa_http::verify_response(
        timestamp,
        nonce,
        body,
        signature,
        key,
        now_seconds,
        max_age_seconds,
    )
}
mod benchmarks;
mod known_answer_tests;
