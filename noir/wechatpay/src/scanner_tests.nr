    fn rejects_payer_array() {
        check(
            "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":[{\"openid\":\"test-openid-001\"}],\"amount\":{\"total\":2500,\"currency\":\"CNY\"}}",
            2500,
        );
    }

    // payer must be an object, not a string. (256 bytes)
    #[test(should_fail_with = "required claim must have expected type")]
    fn rejects_string_payer() {
        check(
            "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":\"test-openid-001\",\"amount\":{\"total\":2500,\"currency\":\"CNY\"}}",
            2500,
        );
    }

    // payer must be an object, not a scalar. (243 bytes)
    #[test(should_fail_with = "required claim must have expected type")]
    fn rejects_scalar_payer() {
        check(
            "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":null,\"amount\":{\"total\":2500,\"currency\":\"CNY\"}}",
            2500,
        );
    }

    // A duplicate amount.currency object is rejected. (281 bytes)
    #[test(should_fail_with = "required claim must have expected type")]
    fn rejects_currency_object_after_cny() {
        check(
            "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":{\"openid\":\"test-openid-001\"},\"amount\":{\"total\":2500,\"currency\":\"CNY\",\"currency\":{}}}",
            2500,
        );
    }
}
