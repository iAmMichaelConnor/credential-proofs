//! Generated by scripts/fixtures/generate-wechatpay-scanner-tests.py; do not edit.
//! Regression tests of the claims scanner.
//! The bodies are synthetic and unsigned; see the generator for their source.
use crate::claims::assert_payment_claims;

// black_box keeps the body and total opaque, so the parser constraints run
// instead of folding at compile time.
fn check<let L: u32>(body: str<L>, expected_total: u64) {
    let body: BoundedVec<u8, 1024> = BoundedVec::from_array(body.as_bytes());
    assert_payment_claims(
        std::hint::black_box(body),
        BoundedVec::from_array("wx123456".as_bytes()),
        BoundedVec::from_array("1900000001".as_bytes()),
        BoundedVec::from_array("4200000000202410100000000001".as_bytes()),
        BoundedVec::from_array("test-openid-001".as_bytes()),
        BoundedVec::from_array("0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
            .as_bytes()),
        std::hint::black_box(expected_total),
    );
}

// Amount may end directly after its integer total. (266 bytes)
#[test]
fn accepts_amount_ending_in_total_without_whitespace() {
    check(
        "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":{\"openid\":\"test-openid-001\"},\"amount\":{\"currency\":\"CNY\",\"total\":100}}",
        100,
    );
}

// The total check still runs when total ends the amount object. (267 bytes)
#[test(should_fail_with = "wrong amount.total")]
fn rejects_wrong_total_when_total_ends_amount() {
    check(
        "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":{\"openid\":\"test-openid-001\"},\"amount\":{\"currency\":\"CNY\",\"total\":2500}}",
        2501,
    );
}

// A repeated total that ends the amount object is still rejected. (280 bytes)
#[test(should_fail_with = "duplicate amount.total")]
fn rejects_duplicate_total_ending_amount() {
    check(
        "{\"appid\":\"wx123456\",\"mchid\":\"1900000001\",\"trade_state\":\"SUCCESS\",\"transaction_id\":\"4200000000202410100000000001\",\"attach\":\"0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\"payer\":{\"openid\":\"test-openid-001\"},\"amount\":{\"total\":2500,\"currency\":\"CNY\",\"total\":2500}}",
        2500,
    );
}

