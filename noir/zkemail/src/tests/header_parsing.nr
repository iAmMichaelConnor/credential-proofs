        let header: BoundedVec<u8, 301> = BoundedVec::from_array(
            comptime {
                "dkim-signature:v=1; a=rsa-sha256; c=relaxed/relaxed; d=service.example; s=s1; z=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa; h=from:to; bh=XMz8sw/KEiF8NFRev62zHVFSmPc2EcRT+4clLYGUxHg=; b="
                    .as_bytes()
            },
        );
        let sequence = Sequence { index: 0, length: 301 };
        let _ = get_body_hash(header, sequence, 253);
    }

