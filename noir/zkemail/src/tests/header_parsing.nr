        constrain_header_field::<29, 64, 7>(
            header,
            Sequence { index: 0, length: 16 },
            comptime { "Subject".as_bytes() },
        );
    }

    #[test]
    fn terminal_subject() {
        let header: BoundedVec<u8, 16> =
            BoundedVec::from_array(comptime { "Subject: approve".as_bytes() });
        constrain_header_field::<16, 64, 7>(
            header,
            Sequence { index: 0, length: 16 },
            comptime { "Subject".as_bytes() },
        );
    }

