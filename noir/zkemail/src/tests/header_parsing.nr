mod email_address {
    use crate::{headers::email_address::get_email_address, Sequence};

    // 'bob . alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_obs_local_part_with_spaces_is_rejected() {
        let header: BoundedVec<u8, 32> = BoundedVec::from_array(
            comptime { "\r\nfrom:bob . alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 28 },
            Sequence { index: 13, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // 'bob. alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_obs_local_part_with_trailing_space_is_rejected() {
        let header: BoundedVec<u8, 31> = BoundedVec::from_array(
            comptime { "\r\nfrom:bob. alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 27 },
            Sequence { index: 12, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // 'bob.(c) alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_obs_local_part_with_comment_is_rejected() {
        let header: BoundedVec<u8, 34> = BoundedVec::from_array(
            comptime { "\r\nfrom:bob.(c) alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 30 },
            Sequence { index: 15, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // '"bob". alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_obs_local_part_with_quoted_word_is_rejected() {
        let header: BoundedVec<u8, 33> = BoundedVec::from_array(
            comptime { "\r\nfrom:\"bob\". alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 29 },
            Sequence { index: 14, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // 'bob (c) . alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_obs_local_part_with_comment_before_dot_is_rejected() {
        let header: BoundedVec<u8, 36> = BoundedVec::from_array(
            comptime { "\r\nfrom:bob (c) . alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 32 },
            Sequence { index: 17, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // '(c) . alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_obs_local_part_after_comment_is_rejected() {
        let header: BoundedVec<u8, 32> = BoundedVec::from_array(
            comptime { "\r\nfrom:(c) . alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 28 },
            Sequence { index: 13, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // 'bob, alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_address_list_is_rejected() {
        let header: BoundedVec<u8, 31> = BoundedVec::from_array(
            comptime { "\r\nfrom:bob, alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 27 },
            Sequence { index: 12, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // 'Bob Smith alice@example.com' does not name alice@example.com; the span is a strict suffix.
    #[test(should_fail_with = "Bare mailbox address must be preceded only by whitespace or comments")]
    fn bare_unquoted_display_name_without_brackets_is_rejected() {
        let header: BoundedVec<u8, 36> = BoundedVec::from_array(
            comptime { "\r\nfrom:Bob Smith alice@example.com\r\n".as_bytes() },
        );
        let _ = get_email_address(
            header,
            Sequence { index: 2, length: 32 },
            Sequence { index: 17, length: 17 },
            comptime { "from".as_bytes() },
        );
    }

    // CFWS around the mailbox stays accepted.
    #[test]
    fn bare_spaces_is_accepted() {
        let header: BoundedVec<u8, 30> =
            BoundedVec::from_array(comptime { "\r\nfrom:  alice@example.com  \r\n".as_bytes() });
        let address = get_email_address(
            header,
            Sequence { index: 2, length: 26 },
            Sequence { index: 9, length: 17 },
            comptime { "from".as_bytes() },
        );
        assert_eq(address, BoundedVec::from_array(comptime { "alice@example.com".as_bytes() }));
    }

    // CFWS around the mailbox stays accepted.
    #[test]
    fn bare_tab_and_comment_is_accepted() {
        let header: BoundedVec<u8, 61> = BoundedVec::from_array(
            comptime {
                "\r\nfrom:\t(note: bob.alice@example.com) alice@example.com (c)\r\n".as_bytes()
            },
        );
        let address = get_email_address(
            header,
            Sequence { index: 2, length: 57 },
            Sequence { index: 38, length: 17 },
            comptime { "from".as_bytes() },
        );
        assert_eq(address, BoundedVec::from_array(comptime { "alice@example.com".as_bytes() }));
    }

    // CFWS around the mailbox stays accepted.
    #[test]
    fn angle_form_display_name_is_accepted() {
        let header: BoundedVec<u8, 38> = BoundedVec::from_array(
            comptime { "\r\nfrom:Bob Smith <alice@example.com>\r\n".as_bytes() },
        );
        let address = get_email_address(
            header,
            Sequence { index: 2, length: 34 },
            Sequence { index: 18, length: 17 },
            comptime { "from".as_bytes() },
        );
        assert_eq(address, BoundedVec::from_array(comptime { "alice@example.com".as_bytes() }));
    }
}
